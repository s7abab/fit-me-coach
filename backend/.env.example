# Neon: the pooled DATABASE_URL that `neon link` writes to .env.local in the repo root
# Local Docker database (docker-compose.yaml): postgresql://coach:coach@localhost:5433/coach
DATABASE_URL=postgresql://coach:coach@localhost:5433/coach

# Any OpenAI-compatible chat API
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai.gpt-oss-120b

# Voyage AI: embeddings and reranking for guideline search. Key from https://dashboard.voyageai.com
VOYAGE_API_KEY=
# Keys made in MongoDB Atlas only work with https://ai.mongodb.com/v1
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-3-lite

# Signs the short-lived token the Next.js server sends with each request.
# Same value as API_JWT_SECRET in frontend/.env. Generate with: openssl rand -base64 32
API_JWT_SECRET=

# Encrypts Google refresh tokens in the database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# The same Google OAuth client as AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET in frontend/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
