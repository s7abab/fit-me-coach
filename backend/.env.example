DATABASE_URL=postgresql://coach:coach@localhost:5433/coach

# Any OpenAI-compatible chat API
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai.gpt-oss-120b

# Signs the short-lived token the Next.js server sends with each request.
# Same value as API_JWT_SECRET in frontend/.env. Generate with: openssl rand -base64 32
API_JWT_SECRET=

# Encrypts Google refresh tokens in the database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# The same Google OAuth client as AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET in frontend/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
