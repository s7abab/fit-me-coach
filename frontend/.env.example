# Auth.js session encryption key: generate with `npx auth secret`
AUTH_SECRET=

# The public address of this app. Auth.js builds the Google redirect URI from it.
AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console > APIs & Services > Credentials), with the Google Health API enabled.
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Where the FastAPI backend runs. Only the Next.js server calls it; never sent to the browser.
API_URL=http://127.0.0.1:8000

# Signs the short-lived token sent to FastAPI. Same value as API_JWT_SECRET in backend/.env.
API_JWT_SECRET=
